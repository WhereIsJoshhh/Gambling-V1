# URL de MongoDB Atlas (mongodb+srv://...)
MONGOOSE_DB_LINK=
# Secreto para sesiones de Passport (una cadena larga y aleatoria)
PASSPORT_SECRET=
# Puerto del servidor (lo inyecta la plataforma: Render/Railway/Fly)
PORT=4000
# Origen publico del frontend en Vercel, para CORS con credenciales
CLIENT_URL=https://tu-proyecto.vercel.app
# Opcional: id del documento de game loop si reutilizas la base de datos original
GAME_LOOP_ID=
